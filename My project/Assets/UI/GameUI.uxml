<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameUI.uss?fileID=7433441132597879392&amp;guid=ed8ca25550dcbbe4094ce88587485c54&amp;type=3#GameUI" />
    <ui:VisualElement name="hud" class="hud">
        <ui:VisualElement name="sky-icons" class="sky-icons">
            <ui:VisualElement name="sun-icon" class="sky-icon" />
            <ui:VisualElement name="moon-icon" class="sky-icon" />
        </ui:VisualElement>
        <ui:VisualElement name="chop-bar-container" class="chop-bar-container hidden">
            <ui:ProgressBar name="chop-bar" low-value="0" high-value="1" class="chop-bar" />
        </ui:VisualElement>
        <ui:VisualElement name="hotbar" class="hotbar">
            <ui:VisualElement name="hb-0" class="hb-slot">
                <ui:VisualElement name="hb-icon-0" class="slot-icon" />
                <ui:Label name="hb-count-0" class="slot-count" />
            </ui:VisualElement>
            <ui:VisualElement name="hb-1" class="hb-slot">
                <ui:VisualElement name="hb-icon-1" class="slot-icon" />
                <ui:Label name="hb-count-1" class="slot-count" />
            </ui:VisualElement>
            <ui:VisualElement name="hb-2" class="hb-slot">
                <ui:VisualElement name="hb-icon-2" class="slot-icon" />
                <ui:Label name="hb-count-2" class="slot-count" />
            </ui:VisualElement>
            <ui:VisualElement name="hb-3" class="hb-slot">
                <ui:VisualElement name="hb-icon-3" class="slot-icon" />
                <ui:Label name="hb-count-3" class="slot-count" />
            </ui:VisualElement>
            <ui:VisualElement name="hb-4" class="hb-slot">
                <ui:VisualElement name="hb-icon-4" class="slot-icon" />
                <ui:Label name="hb-count-4" class="slot-count" />
            </ui:VisualElement>
            <ui:VisualElement name="hb-5" class="hb-slot">
                <ui:VisualElement name="hb-icon-5" class="slot-icon" />
                <ui:Label name="hb-count-5" class="slot-count" />
            </ui:VisualElement>
            <ui:VisualElement name="hb-6" class="hb-slot">
                <ui:VisualElement name="hb-icon-6" class="slot-icon" />
                <ui:Label name="hb-count-6" class="slot-count" />
            </ui:VisualElement>
            <ui:VisualElement name="hb-7" class="hb-slot">
                <ui:VisualElement name="hb-icon-7" class="slot-icon" />
                <ui:Label name="hb-count-7" class="slot-count" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="inventory-panel" class="panel-overlay hidden">
        <ui:VisualElement class="wood-frame">
            <ui:VisualElement class="frame-header">
                <ui:VisualElement class="header-left">
                    <ui:VisualElement class="rivet" />
                    <ui:Label text="Camp — Day 1 of 3" class="frame-title" />
                </ui:VisualElement>
                <ui:VisualElement class="header-right">
                    <ui:VisualElement class="rivet" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="snow-interior">
                <ui:VisualElement class="three-col">
                    <ui:VisualElement class="col-left">
                        <ui:Label text="EQUIPMENT" class="col-section-label" />
                        <ui:VisualElement class="equip-row">
                            <ui:VisualElement name="equip-hat" class="equip-slot-sm">
                                <ui:VisualElement name="equip-hat-icon" class="equip-icon-sm" />
                                <ui:Label text="Hat" class="equip-slot-label" />
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-coat" class="equip-slot-sm">
                                <ui:VisualElement name="equip-coat-icon" class="equip-icon-sm" />
                                <ui:Label text="Coat" class="equip-slot-label" />
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-boots" class="equip-slot-sm equip-slot-empty-dashed">
                                <ui:Label text="+" class="equip-plus" />
                                <ui:Label text="Boots" class="equip-slot-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-divider" />
                        <ui:Label text="TOOLS" class="col-section-label" />
                        <ui:VisualElement class="equip-row">
                            <ui:VisualElement name="equip-axe" class="equip-slot-tool">
                                <ui:VisualElement name="equip-axe-icon" class="equip-icon-tool" />
                                <ui:Label name="equip-axe-label" text="Axe" class="equip-slot-label-bold" />
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-pickaxe" class="equip-slot-tool">
                                <ui:VisualElement name="equip-pickaxe-icon" class="equip-icon-tool" />
                                <ui:Label text="Pickaxe" class="equip-slot-label-bold" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="col-center">
                        <ui:VisualElement class="backpack-card">
                            <ui:VisualElement class="backpack-header">
                                <ui:Label text="BACKPACK" class="backpack-title" />
                            </ui:VisualElement>
                            <ui:VisualElement class="inv-grid">
                                <ui:VisualElement name="inv-slot-0" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-0" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-0" class="slot-count-lg" />
                                    <ui:Label name="inv-name-0" class="slot-name" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-slot-1" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-1" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-1" class="slot-count-lg" />
                                    <ui:Label name="inv-name-1" class="slot-name" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-slot-2" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-2" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-2" class="slot-count-lg" />
                                    <ui:Label name="inv-name-2" class="slot-name" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-slot-3" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-3" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-3" class="slot-count-lg" />
                                    <ui:Label name="inv-name-3" class="slot-name" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-slot-4" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-4" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-4" class="slot-count-lg" />
                                    <ui:Label name="inv-name-4" class="slot-name" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-slot-5" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-5" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-5" class="slot-count-lg" />
                                    <ui:Label name="inv-name-5" class="slot-name" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-slot-6" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-6" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-6" class="slot-count-lg" />
                                    <ui:Label name="inv-name-6" class="slot-name" />
                                </ui:VisualElement>
                                <ui:VisualElement name="inv-slot-7" class="inv-slot">
                                    <ui:VisualElement name="inv-icon-7" class="slot-icon-lg" />
                                    <ui:Label name="inv-count-7" class="slot-count-lg" />
                                    <ui:Label name="inv-name-7" class="slot-name" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="col-right">
                        <ui:Label text="RECIPES" class="col-section-label" />
                        <ui:ScrollView name="recipe-list" class="recipe-list" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="frame-footer">
                <ui:Label text="[Tab] Close · [E] Equip · [F] Use · [Q] Drop" class="footer-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="drag-ghost" class="drag-ghost hidden" />
    </ui:VisualElement>
    <ui:VisualElement name="crafting-panel" class="panel-overlay hidden">
        <ui:VisualElement class="panel-card">
            <ui:VisualElement class="panel-header">
                <ui:Label text="Campfire" class="panel-title" />
                <ui:Label text="Press C to close" class="panel-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="section">
                <ui:VisualElement class="section-row">
                    <ui:Label text="Fuel" class="section-label" />
                    <ui:Label name="fuel-text" text="0 / 100" class="section-value" />
                </ui:VisualElement>
                <ui:ProgressBar name="fuel-bar" low-value="0" high-value="1" class="fuel-bar" />
            </ui:VisualElement>
            <ui:VisualElement class="section">
                <ui:Label name="shelter-text" text="Shelter Level: 0 / 3" class="section-label" />
                <ui:VisualElement class="level-pips">
                    <ui:VisualElement name="pip-0" class="pip" />
                    <ui:VisualElement name="pip-1" class="pip" />
                    <ui:VisualElement name="pip-2" class="pip" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="divider" />
            <ui:ScrollView name="campfire-recipe-list" class="recipe-list campfire-recipes" />
            <ui:VisualElement class="divider" />
            <ui:Button name="add-fuel-btn" class="action-btn">
                <ui:Label text="Add fuel" class="action-title" />
                <ui:Label name="fuel-cost-text" text="1 wood" class="action-cost" />
            </ui:Button>
            <ui:Button name="upgrade-btn" class="action-btn">
                <ui:Label text="Upgrade shelter" class="action-title" />
                <ui:Label name="upgrade-cost-text" text="3 wood + 2 stone" class="action-cost" />
            </ui:Button>
            <ui:VisualElement class="inv-summary">
                <ui:Label name="wood-count" text="Wood: 0" class="inv-summary-item" />
                <ui:Label name="stone-count" text="Stone: 0" class="inv-summary-item" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
