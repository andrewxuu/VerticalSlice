/* ════════════════════════════════════════════════════════════════════════════
   GameUI.uss  —  Survival Game UI Stylesheet
════════════════════════════════════════════════════════════════════════════ */


/* ════════════════════════════════════════════════════════════════════════════
   UTILITY
════════════════════════════════════════════════════════════════════════════ */
.hidden { display: none; }


/* ════════════════════════════════════════════════════════════════════════════
   HUD ROOT
════════════════════════════════════════════════════════════════════════════ */
.hud {
    position: absolute;
    width: 100%;
    height: 100%;
}


/* ════════════════════════════════════════════════════════════════════════════
   STATUS BARS  (top-left: warmth + health)
════════════════════════════════════════════════════════════════════════════ */
.status-bars {
    position: absolute;
    top: 20px;
    left: 20px;
    flex-direction: column;
}

.status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    background-color: rgba(26, 19, 12, 0.55);
    border-radius: 8px;
    padding: 5px 10px 5px 8px;
    border-width: 1px;
    border-color: rgba(90, 74, 56, 0.5);
}

.status-icon {
    font-size: 14px;
    width: 20px;
    -unity-text-align: middle-center;
    margin-right: 7px;
}

.status-icon--warmth { color: rgb(239, 159, 39); }
.status-icon--health { color: rgb(210, 80, 80);  }

.status-bar-track { width: 148px; }

/* Warmth bar */
.warmth-bar { width: 100%; }
.warmth-bar .unity-progress-bar__background {
    height: 10px; border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px; border-color: rgba(90, 74, 56, 0.7);
}
.warmth-bar .unity-progress-bar__progress {
    border-radius: 4px;
    background-color: rgb(239, 159, 39);
}
.warmth-bar.warmth-cold .unity-progress-bar__progress {
    background-color: rgb(90, 170, 230);
}
.warmth-bar .unity-progress-bar__title { display: none; }

/* Health bar */
.health-bar { width: 100%; }
.health-bar .unity-progress-bar__background {
    height: 10px; border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px; border-color: rgba(90, 74, 56, 0.7);
}
.health-bar .unity-progress-bar__progress {
    border-radius: 4px;
    background-color: rgb(72, 190, 100);
}
.health-bar.health-low .unity-progress-bar__progress {
    background-color: rgb(210, 65, 55);
}
.health-bar .unity-progress-bar__title { display: none; }


/* ════════════════════════════════════════════════════════════════════════════
   SKY ICONS  (top-right)
════════════════════════════════════════════════════════════════════════════ */
.sky-icons {
    position: absolute;
    top: 20px;
    right: 20px;
    flex-direction: row;
}

.sky-icon {
    width: 40px;
    height: 40px;
    margin-left: 8px;
    -unity-background-scale-mode: scale-to-fit;
}


/* ════════════════════════════════════════════════════════════════════════════
   CHOP PROGRESS BAR  (top-centre)
════════════════════════════════════════════════════════════════════════════ */
.chop-bar-container {
    position: absolute;
    top: 58px;
    left: 50%;
    width: 210px;
    margin-left: -105px;
    align-items: center;
    background-color: rgba(26, 19, 12, 0.7);
    border-radius: 10px;
    padding: 6px 12px 8px 12px;
    border-width: 1px;
    border-color: rgba(90, 74, 56, 0.6);
}

.chop-label {
    font-size: 10px;
    color: rgb(176, 160, 144);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.chop-bar { width: 100%; }
.chop-bar .unity-progress-bar__background {
    height: 12px; border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px; border-color: rgba(90, 74, 56, 0.6);
}
.chop-bar .unity-progress-bar__progress {
    border-radius: 5px;
    background-color: rgb(239, 159, 39);
}
.chop-bar .unity-progress-bar__title { display: none; }


/* ════════════════════════════════════════════════════════════════════════════
   HOTBAR  (bottom-centre)
════════════════════════════════════════════════════════════════════════════ */
.hotbar {
    position: absolute;
    bottom: 24px;
    left: 50%;
    margin-left: -292px;
    flex-direction: row;
    padding: 6px 8px;
    background-color: rgba(26, 19, 12, 0.85);
    border-radius: 14px;
    border-width: 1.5px;
    border-color: rgba(90, 74, 56, 0.75);
}

.hb-slot {
    width: 62px;
    height: 62px;
    margin: 0 3px;
    background-color: rgba(58, 42, 26, 0.75);
    border-width: 1px;
    border-color: rgba(90, 74, 56, 0.55);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
}
.hb-slot:hover { background-color: rgb(74, 54, 34); border-color: rgb(120, 98, 72); }

.slot-icon { width: 38px; height: 38px; -unity-background-scale-mode: scale-to-fit; }

.slot-count {
    position: absolute;
    bottom: 3px; right: 6px;
    font-size: 11px;
    color: rgb(232, 220, 200);
    -unity-font-style: bold;
}


/* ════════════════════════════════════════════════════════════════════════════
   SIDE-PANEL OVERLAYS
════════════════════════════════════════════════════════════════════════════ */
.side-panel-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.side-panel-left  { align-items: flex-start; padding-left:  5%; }
.side-panel-right { align-items: flex-end;   padding-right: 3%; }


/* ════════════════════════════════════════════════════════════════════════════
   PANEL CARD
════════════════════════════════════════════════════════════════════════════ */
.panel-card {
    width: 320px;
    background-color: rgb(42, 31, 20);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(90, 74, 56);
    overflow: hidden;
    scale: 1.2;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 13px 18px;
    background-color: rgb(58, 42, 26);
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 74, 56);
}

.panel-title { font-size: 16px; color: rgb(245, 220, 192); -unity-font-style: bold; }
.panel-hint  { font-size: 11px; color: rgb(138, 122, 104); }

.section        { padding: 14px 18px 8px 18px; }
.section-row    { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.section-label  { font-size: 13px; color: rgb(176, 160, 144); -unity-font-style: bold; }
.section-value  { font-size: 12px; color: rgb(138, 122, 104); }

.divider { height: 1px; background-color: rgb(58, 42, 26); margin: 6px 18px; }


/* ════════════════════════════════════════════════════════════════════════════
   EQUIPMENT SLOTS
════════════════════════════════════════════════════════════════════════════ */
.col-section-label {
    font-size: 10px; color: rgb(138, 122, 104);
    -unity-font-style: bold; letter-spacing: 0.5px; margin-bottom: 10px;
}
.col-divider { height: 1px; background-color: rgb(90, 74, 56); margin: 12px 0; }
.equip-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }

.equip-slot-sm {
    width: 58px; height: 58px;
    margin: 0 6px 8px 0;
    background-color: rgb(58, 42, 26);
    border-width: 1.2px; border-color: rgb(90, 74, 56);
    border-radius: 8px;
    align-items: center; justify-content: center; flex-direction: column;
}
.equip-slot-sm:hover { border-color: rgb(239, 159, 39); }
.equip-slot-empty-dashed { border-color: rgb(90, 74, 56); opacity: 0.5; }
.equip-icon-sm  { width: 32px; height: 32px; -unity-background-scale-mode: scale-to-fit; }
.equip-plus     { font-size: 20px; color: rgb(90, 74, 56); }
.equip-slot-label { font-size: 9px; color: rgb(138, 122, 104); position: absolute; bottom: -14px; }

.equip-slot-tool {
    width: 68px; height: 58px;
    margin: 0 8px 8px 0;
    background-color: rgb(58, 42, 26);
    border-width: 1.8px; border-color: rgb(239, 159, 39);
    border-radius: 8px;
    align-items: center; justify-content: center; flex-direction: column;
}
.equip-slot-tool:hover { background-color: rgb(74, 54, 34); }
.equip-icon-tool { width: 36px; height: 36px; -unity-background-scale-mode: scale-to-fit; }
.equip-slot-label-bold { font-size: 9px; color: rgb(245, 220, 192); -unity-font-style: bold; position: absolute; bottom: -14px; }
.equip-slot-filled { border-color: rgb(239, 159, 39); background-color: rgb(74, 54, 34); }


/* ════════════════════════════════════════════════════════════════════════════
   DRAG GHOST
════════════════════════════════════════════════════════════════════════════ */
.drag-ghost {
    position: absolute;
    width: 48px; height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.85;
}


/* ════════════════════════════════════════════════════════════════════════════
   CAMPFIRE STATUS PANEL
════════════════════════════════════════════════════════════════════════════ */
.fuel-bar { margin-top: 4px; }
.fuel-bar .unity-progress-bar__background {
    height: 12px; border-radius: 6px;
    background-color: rgb(26, 20, 16);
    border-width: 1px; border-color: rgb(58, 42, 26);
}
.fuel-bar .unity-progress-bar__progress { border-radius: 5px; background-color: rgb(239, 159, 39); }
.fuel-bar .unity-progress-bar__title { display: none; }

.level-pips { flex-direction: row; margin-top: 8px; }
.pip {
    flex-grow: 1; height: 26px; border-radius: 6px;
    background-color: rgb(58, 42, 26);
    border-width: 1px; border-color: rgb(58, 42, 26);
    margin-right: 6px;
}
.pip-active { background-color: rgb(29, 158, 117); border-color: rgb(93, 202, 165); }

.action-btn {
    flex-direction: row;
    align-items: center; justify-content: space-between;
    margin: 4px 18px;
    padding: 11px 14px;
    background-color: rgb(42, 31, 20);
    border-width: 1px; border-color: rgb(90, 74, 56);
    border-radius: 10px;
}
.action-btn:hover    { background-color: rgb(58, 42, 26); border-color: rgb(120, 98, 72); }
.action-btn:disabled { opacity: 0.4; }
.action-title { font-size: 14px; color: rgb(245, 220, 192); -unity-font-style: bold; }
.action-cost  { font-size: 12px; color: rgb(138, 122, 104); }

.inv-summary { flex-direction: row; justify-content: center; padding: 10px 18px 16px 18px; margin-top: 6px; }
.inv-summary-item { font-size: 12px; color: rgb(138, 122, 104); margin: 0 10px; }


/* ════════════════════════════════════════════════════════════════════════════
   SHARED CRAFTING + BACKPACK PANEL  (right side)
════════════════════════════════════════════════════════════════════════════ */
.campfire-right-card { width: 300px; flex-direction: column; scale: 1.2; }

.campfire-right-section {
    background-color: rgb(42, 31, 20);
    border-radius: 14px;
    border-width: 2px; border-color: rgb(90, 74, 56);
    overflow: hidden;
    margin-bottom: 10px;
}
.campfire-inv-section { margin-bottom: 0; }

.inv-grid-compact {
    flex-direction: row; flex-wrap: wrap;
    padding: 10px 12px;
    justify-content: center;
}

.inv-slot-sm {
    width: 56px; height: 56px; margin: 3px;
    background-color: rgb(58, 42, 26);
    border-width: 1px; border-color: rgb(90, 74, 56);
    border-radius: 8px;
    align-items: center; justify-content: center;
    overflow: visible;
}
.inv-slot-sm:hover { border-color: rgb(239, 159, 39); background-color: rgb(74, 54, 34); }

.slot-icon-sm  { width: 34px; height: 34px; -unity-background-scale-mode: scale-to-fit; }
.slot-count-sm {
    position: absolute; bottom: 2px; right: 4px;
    font-size: 9px; color: rgb(245, 220, 192); -unity-font-style: bold;
    background-color: rgba(26, 20, 16, 0.85);
    padding: 1px 3px; border-radius: 3px;
}

.inv-slot-selected { border-color: rgb(239, 159, 39); border-width: 2px; background-color: rgb(74, 54, 34); }
.inv-slot-empty    { border-color: rgb(90, 74, 56); opacity: 0.4; }
.inv-slot-drag-over { border-color: rgb(29, 158, 117); border-width: 2px; background-color: rgb(20, 55, 38); }


/* ════════════════════════════════════════════════════════════════════════════
   RECIPE LIST
════════════════════════════════════════════════════════════════════════════ */
.recipe-list { flex-grow: 1; }
.campfire-recipes-right { padding: 8px 12px; max-height: 200px; }

.recipe-btn {
    flex-direction: column;
    padding: 9px 12px; margin-bottom: 6px;
    background-color: rgb(58, 42, 26);
    border-width: 1.5px; border-color: rgb(90, 74, 56);
    border-radius: 8px;
}
.recipe-btn:hover    { background-color: rgb(74, 54, 34); border-color: rgb(239, 159, 39); }
.recipe-btn:disabled { opacity: 0.4; }
.recipe-title { font-size: 12px; color: rgb(245, 220, 192); -unity-font-style: bold; }
.recipe-cost  { font-size: 10px; color: rgb(138, 122, 104); margin-top: 2px; }


/* ════════════════════════════════════════════════════════════════════════════
   DEATH SCREEN
════════════════════════════════════════════════════════════════════════════ */
.death-screen {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    /* Deep red-black vignette */
    background-color: rgba(18, 4, 4, 0.88);
}

.death-card {
    align-items: center;
    justify-content: center;
    padding: 48px 64px;
    background-color: rgba(30, 8, 8, 0.75);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(160, 40, 40, 0.6);
}

.death-title {
    font-size: 64px;
    color: rgb(210, 55, 55);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-bottom: 12px;
}

.death-subtitle {
    font-size: 16px;
    color: rgb(176, 140, 130);
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    letter-spacing: 1px;
}

.restart-btn {
    width: 200px;
    height: 52px;
    align-items: center;
    justify-content: center;
    background-color: rgba(160, 40, 40, 0.3);
    border-width: 2px;
    border-color: rgb(160, 40, 40);
    border-radius: 10px;
    margin-top: 8px;
}
.restart-btn:hover {
    background-color: rgba(200, 60, 60, 0.5);
    border-color: rgb(210, 80, 80);
}

.restart-label {
    font-size: 18px;
    color: rgb(245, 200, 190);
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}
