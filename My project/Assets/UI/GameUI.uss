/* ═══ Utility ═══ */
.hidden { display: none; }

/* ═══ HUD ═══ */
.hud { position: absolute; width: 100%; height: 100%; }

.sky-icons { position: absolute; top: 20px; right: 20px; flex-direction: row; }
.sky-icon { width: 40px; height: 40px; margin-left: 8px; -unity-background-scale-mode: scale-to-fit; }

.chop-bar-container { position: absolute; top: 60px; left: 50%; width: 200px; margin-left: -100px; }
.chop-bar .unity-progress-bar__background { height: 14px; border-radius: 7px; background-color: rgba(0,0,0,0.5); border-width: 1px; border-color: rgba(90,74,56,0.6); }
.chop-bar .unity-progress-bar__progress { border-radius: 7px; background-color: rgb(239,159,39); }
.chop-bar .unity-progress-bar__title { display: none; }

.hotbar { position: absolute; bottom: 24px; left: 50%; margin-left: -288px; flex-direction: row; padding: 6px; background-color: rgba(42,31,20,0.8); border-radius: 14px; border-width: 1.5px; border-color: rgba(90,74,56,0.7); }
.hb-slot { width: 60px; height: 60px; margin: 0 3px; background-color: rgba(58,42,26,0.7); border-width: 1px; border-color: rgba(90,74,56,0.5); border-radius: 10px; align-items: center; justify-content: center; }
.slot-icon { width: 36px; height: 36px; -unity-background-scale-mode: scale-to-fit; }
.slot-count { position: absolute; bottom: 2px; right: 6px; font-size: 11px; color: rgb(232,220,200); -unity-font-style: bold; }

/* ═══ PANEL OVERLAY ═══ */
.panel-overlay { position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(28,31,46,0.85); }

/* Suppresses backdrop when two panels open together */
.panel-overlay.no-backdrop { background-color: rgba(0,0,0,0); }

/* Campfire panel — left side */
#crafting-panel { justify-content: center; align-items: flex-start; padding-left: 8%; }

/* Inventory panel — right side when shown with campfire */
#inventory-panel.with-campfire { justify-content: center; align-items: flex-end; padding-right: 5%; }


/* ═══ INVENTORY OVERLAY — matches campfire side panel positioning ═══ */
.inv-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.4);
    padding-left: 3%;
    padding-right: 3%;
}

/* Each floating panel card — matches campfire style exactly */
.inv-card {
    background-color: rgb(42, 31, 20);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(90, 74, 56);
    overflow: hidden;
    min-width: 220px;
    max-width: 340px;
}

/* Vertical stack — backpack on top, recipes below */
.inv-stack {
    flex-direction: column;
    min-width: 220px;
    max-width: 340px;
}

.inv-stack .inv-card {
    margin-bottom: 10px;
}

.inv-stack .inv-card:last-child {
    margin-bottom: 0;
}

.inv-card-body {
    padding: 16px;
}

.inv-card-footer {
    padding: 8px 16px;
    background-color: rgb(58, 42, 26);
    border-top-width: 1px;
    border-top-color: rgb(90, 74, 56);
    align-items: center;
}

/* ═══ EQUIPMENT SLOTS ═══ */
.col-section-label {
    font-size: 10px;
    color: rgb(176, 160, 144);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
}

.col-divider {
    height: 1px;
    background-color: rgb(90, 74, 56);
    margin: 12px 0;
}
.equip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

/* Small armor slots */
.equip-slot-sm {
    width: 58px;
    height: 58px;
    margin: 0 6px 8px 0;
    background-color: rgb(58, 42, 26);
    border-width: 1.2px;
    border-color: rgb(90, 74, 56);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.equip-slot-sm:hover { border-color: rgb(239, 159, 39); }

.equip-slot-empty-dashed {
    border-color: rgb(90, 74, 56);
    opacity: 0.5;
}

.equip-icon-sm {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.equip-plus {
    font-size: 20px;
    color: rgb(90, 74, 56);
}

.equip-slot-label {
    font-size: 9px;
    color: rgb(138, 122, 104);
    position: absolute;
    bottom: -14px;
}

/* Tool slots (larger) */
.equip-slot-tool {
    width: 68px;
    height: 56px;
    margin: 0 8px 8px 0;
    background-color: rgb(58, 42, 26);
    border-width: 1.8px;
    border-color: rgb(239, 159, 39);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.equip-slot-tool:hover { background-color: rgb(74, 54, 34); border-color: rgb(239, 159, 39); }

.equip-icon-tool {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.equip-slot-label-bold {
    font-size: 9px;
    color: rgb(245, 220, 192);
    -unity-font-style: bold;
    position: absolute;
    bottom: -14px;
}

.equip-slot-filled {
    border-color: rgb(239, 159, 39);
    background-color: rgb(74, 54, 34);
}

/* ═══ BACKPACK CARD ═══ */
.backpack-card {
    width: 100%;
    max-width: 400px;
    background-color: rgb(42, 31, 20);
    border-width: 1.5px;
    border-color: rgb(90, 74, 56);
    border-radius: 10px;
    overflow: hidden;
}

.backpack-header {
    background-color: rgb(58, 42, 26);
    padding: 8px 16px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 74, 56);
}

.backpack-title {
    font-size: 13px;
    color: rgb(245, 220, 192);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.inv-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
    justify-content: center;
}

.inv-slot {
    width: 54px;
    height: 54px;
    margin: 3px;
    background-color: rgb(58, 42, 26);
    border-width: 1.2px;
    border-color: rgb(90, 74, 56);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.inv-slot:hover {
    border-color: rgb(239, 159, 39);
    background-color: rgb(74, 54, 34);
}

.inv-slot-selected {
    border-color: rgb(239, 159, 39);
    border-width: 2px;
    background-color: rgb(74, 54, 34);
}

.inv-slot-empty {
    border-color: rgb(90, 74, 56);
    opacity: 0.4;
}

.inv-slot-drag-over {
    border-color: rgb(29, 158, 117);
    border-width: 2px;
    background-color: rgb(20, 60, 40);
}

.slot-icon-lg {
    width: 60px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-count-lg {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 9px;
    color: rgb(245, 220, 192);
    -unity-font-style: bold;
    background-color: rgb(26, 20, 16);
    padding: 1px 4px;
    border-radius: 3px;
}

.slot-name {
    position: absolute;
    bottom: -14px;
    font-size: 8px;
    color: rgb(138, 122, 104);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Drag ghost */
.drag-ghost {
    position: absolute;
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.85;
}

/* ═══ RECIPE LIST (inventory + campfire) ═══ */
.recipe-list {
    flex-grow: 1;
}

.recipe-btn {
    flex-direction: column;
    padding: 8px 12px;
    margin-bottom: 6px;
    background-color: rgb(58, 42, 26);
    border-width: 1.5px;
    border-color: rgb(90, 74, 56);
    border-radius: 8px;
}

.recipe-btn:hover {
    background-color: rgb(74, 54, 34);
    border-color: rgb(239, 159, 39);
}

.recipe-btn:disabled { opacity: 0.4; }

.recipe-title {
    font-size: 12px;
    color: rgb(245, 220, 192);
    -unity-font-style: bold;
}

.recipe-cost {
    font-size: 10px;
    color: rgb(138, 122, 104);
    margin-top: 2px;
}

/* ═══ CAMPFIRE PANEL (left side of screen) ═══ */
#crafting-panel {
    justify-content: center;
    align-items: flex-start;
    padding-left: 8%;
}

.panel-card {
    width: 340px;
    background-color: rgb(42, 31, 20);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(90, 74, 56);
    overflow: hidden;
    scale: 1.2;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background-color: rgb(58, 42, 26);
    border-bottom-width: 1px;
    border-bottom-color: rgb(90, 74, 56);
}

.panel-title {
    font-size: 17px;
    color: rgb(245, 220, 192);
    -unity-font-style: bold;
}

.panel-hint {
    font-size: 12px;
    color: rgb(160, 145, 120);
}

.section { padding: 16px 20px 8px 20px; }

.section-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.section-label {
    font-size: 13px;
    color: rgb(176, 160, 144);
    -unity-font-style: bold;
}

.section-value { font-size: 12px; color: rgb(138, 122, 104); }

.fuel-bar { margin-top: 4px; }
.fuel-bar .unity-progress-bar__background { height: 12px; border-radius: 6px; background-color: rgb(26,20,16); border-width: 1px; border-color: rgb(58,42,26); }
.fuel-bar .unity-progress-bar__progress { border-radius: 5px; background-color: rgb(239,159,39); }
.fuel-bar .unity-progress-bar__title { display: none; }

.level-pips { flex-direction: row; margin-top: 8px; }
.pip { flex-grow: 1; height: 28px; border-radius: 6px; background-color: rgb(58,42,26); border-width: 1px; border-color: rgb(58,42,26); margin-right: 6px; }
.pip-active { background-color: rgb(29,158,117); border-color: rgb(93,202,165); }

.divider { height: 1px; background-color: rgb(58,42,26); margin: 8px 20px; }

.campfire-recipes { margin: 0 20px; max-height: 150px; }
.campfire-recipes .recipe-btn { background-color: rgb(58,42,26); border-color: rgb(90,74,56); }
.campfire-recipes .recipe-btn:hover { background-color: rgb(74,54,34); border-color: rgb(239,159,39); }
.campfire-recipes .recipe-title { color: rgb(245,220,192); }
.campfire-recipes .recipe-cost { color: rgb(138,122,104); }

.action-btn {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 4px 20px;
    padding: 12px 14px;
    background-color: rgb(42,31,20);
    border-width: 1px;
    border-color: rgb(90,74,56);
    border-radius: 10px;
}
.action-btn:hover { background-color: rgb(58,42,26); }
.action-btn:disabled { opacity: 0.45; }
.action-title { font-size: 14px; color: rgb(245,220,192); -unity-font-style: bold; }
.action-cost { font-size: 12px; color: rgb(138,122,104); }

.inv-summary { flex-direction: row; justify-content: center; padding: 12px 20px 16px 20px; margin-top: 8px; }
.inv-summary-item { font-size: 12px; color: rgb(138,122,104); margin: 0 12px; }

/* ═══ SIDE PANEL OVERLAYS (campfire) ═══ */
/* Non-blocking overlays — no full backdrop so the character shows in the gap */
.side-panel-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

/* Left side: crafting + inventory */
.side-panel-left {
    align-items: flex-start;
    padding-left: 70%;
}

/* Right side: crafting + backpack */
.side-panel-right {
    align-items: flex-end;
    padding-right: 3%;
}

/* Right card: crafting on top, inventory below */
.campfire-right-card {
    width: 320px;
    flex-direction: column;
    scale: 1.2;
}

.campfire-right-section {
    background-color: rgb(42, 31, 20);
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(90, 74, 56);
    overflow: hidden;
    margin-bottom: 10px;
}

.campfire-inv-section {
    margin-bottom: 0;
}

.campfire-recipes-right {
    padding: 8px 12px;
    max-height: 200px;
}

.campfire-recipes-right .recipe-btn { background-color: rgb(58,42,26); border-color: rgb(90,74,56); }
.campfire-recipes-right .recipe-btn:hover { background-color: rgb(74,54,34); border-color: rgb(239,159,39); }
.campfire-recipes-right .recipe-title { color: rgb(245,220,192); }
.campfire-recipes-right .recipe-cost  { color: rgb(138,122,104); }

/* Compact inventory grid inside campfire UI */
.inv-grid-compact {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 10px 12px;
    justify-content: center;
}

.inv-slot-sm {
    width: 56px;
    height: 56px;
    margin: 3px;
    background-color: rgb(58, 42, 26);
    border-width: 1px;
    border-color: rgb(90, 74, 56);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.inv-slot-sm:hover {
    border-color: rgb(239, 159, 39);
}

.slot-icon-sm {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-count-sm {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 9px;
    color: rgb(245, 220, 192);
    -unity-font-style: bold;
}
